{
  "name": "spotai-review",
  "displayName": "SpotAI-Review Code Assistant",
  "description": "Static Code Analysis, Complexity Metrics & AI-Powered Refactoring for Java & Python",
  "version": "1.1.2",
  "publisher": "group4-ictu",
  "os": ["win32"],
  "cpu": ["x64"],
  "author": "Duong Le Thuong, Duong Quoc Toan & Nguyen Thanh Trung",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Education"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:spotai.openDashboard",
    "onCommand:spotai.reviewSelection",
    "onCommand:spotai.reviewCurrentFile",
    "onCommand:spotai.startServer"
  ],
  "contributes": {
    "commands": [
      {
        "command": "spotai.openDashboard",
        "title": "SpotAI: Open Review Dashboard",
        "category": "SpotAI"
      },
      {
        "command": "spotai.reviewSelection",
        "title": "SpotAI: Review Selected Snippet",
        "category": "SpotAI"
      },
      {
        "command": "spotai.reviewCurrentFile",
        "title": "SpotAI: Analyze Entire Current File",
        "category": "SpotAI"
      },
      {
        "command": "spotai.startServer",
        "title": "SpotAI: Start Local Web Server",
        "category": "SpotAI"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "spotai.reviewSelection",
          "when": "editorHasSelection && (resourceExtname == .py || resourceExtname == .java)",
          "group": "spotai@1"
        },
        {
          "command": "spotai.reviewCurrentFile",
          "when": "resourceExtname == .py || resourceExtname == .java",
          "group": "spotai@2"
        }
      ],
      "editor/title": [
        {
          "command": "spotai.openDashboard",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "spotai.openDashboard"
        },
        {
          "command": "spotai.reviewSelection"
        },
        {
          "command": "spotai.reviewCurrentFile"
        },
        {
          "command": "spotai.startServer"
        }
      ]
    },
    "configuration": {
      "title": "SpotAI-Review Configuration",
      "properties": {
        "spotai.serverUrl": {
          "type": "string",
          "default": "",
          "description": "Optional existing SpotAI HTTP server origin. Leave blank to start the included backend automatically."
        }
      }
    }
  },
  "scripts": {
    "compile": "node -e \"require('fs').copyFileSync('src/extension.ts','extension.js')\"",
    "check": "npm run compile && node --check extension.js",
    "test": "npm run check && node test/runtime.test.js",
    "package": "npm run check && python ../scripts/build_backend.py && python ../scripts/build_vsix.py"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  }
}

